---
layout: null
---
[
{% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: '%Y.%m.%d' | jsonify }},
    "datetime": {{ post.date | date_to_xmlschema | jsonify }},
    "year": {{ post.date | date: '%Y' | jsonify }},
    "year_url": "{{ '/dates/' | relative_url }}#{{ post.date | date: '%Y' }}",
    "tags": {{ post.tags | jsonify }},
    "categories": {{ post.categories | jsonify }},
    "tag_links": [{% for tag in post.tags limit:2 %}{"label": {{ tag | jsonify }}, "url": "{{ '/tags/' | relative_url }}#{{ tag | slugify | uri_escape }}"}{% unless forloop.last %},{% endunless %}{% endfor %}],
    "excerpt": {{ post.excerpt | strip_html | normalize_whitespace | truncate: 170 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
