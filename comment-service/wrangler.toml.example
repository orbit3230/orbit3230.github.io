name = "orbit-blog-comments"
main = "worker.mjs"
compatibility_date = "2026-09-01"
workers_dev = true

[vars]
ALLOWED_ORIGINS = "https://orbit3230.github.io,http://127.0.0.1:4000,http://localhost:4000"

[[d1_databases]]
binding = "DB"
database_name = "orbit-blog-comments"
database_id = "REPLACE_WITH_YOUR_DATABASE_ID"

[triggers]
crons = ["0 3 * * *"]
